# Credentials are NEVER stored in app config files - only here, or in your shell.
# One set per application; the app config refers to them as ${VAR_NAME}.
#
# Copy this file to .env and fill it in with your own values. .env is
# gitignored and must never be shared or committed.

# APPNAME_BASE_URL=http://your-server
# APPNAME_USER=your-username
# APPNAME_PASSWORD=your-password

# Used by any profile that does not name its own credentials:
# DEFAULT_USER=
# DEFAULT_PASSWORD=
