{
  "name": "capa",
  "displayName": "CAPA",
  "baseUrl": "${CAPA_BASE_URL}",
  "credentials": {
    "username": "${CAPA_USER}",
    "password": "${CAPA_PASSWORD}"
  },
  "auth": {
    "strategy": "api",
    "api": {
      "endpoint": "/api/authentication/login",
      "method": "POST",
      "body": {
        "username": "{{username}}",
        "password": "{{password}}",
        "ipAddress": "127.0.0.1",
        "latitude": "0",
        "longitude": "0"
      },
      "sessionStorage": {
        "authToken": "token",
        "userId": "userMaster.userID",
        "plantId": "userMaster.plantID",
        "userData": "userMaster::json"
      }
    },
    "verify": {
      "path": "/dashboard"
    }
  },
  "browser": {
    "headless": true,
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "capture": {
    "settleMs": 900
  },
  "autoFilter": {
    "enabled": true,
    "rangeDays": 365,
    "preferredUser": "Divy Bhadania"
  },
  "discovery": {
    "enabled": true,
    "navSelectors": [
      "aside",
      "nav",
      "[role=\"navigation\"]"
    ],
    "excludePatterns": [
      "logout",
      "signout",
      "^/$",
      "forgot-password"
    ]
  },
  "safety": {
    "readOnly": true,
    "blockMethods": [
      "PUT",
      "PATCH",
      "DELETE"
    ],
    "allowUrlPatterns": [
      "/api/authentication/login"
    ]
  },
  "routes": [
    {
      "module": "Dashboard",
      "name": "Dashboard",
      "slug": "Dashboard",
      "path": "/dashboard"
    },
    {
      "module": "Capa",
      "name": "CAPA Initiation",
      "slug": "CAPA_Initiation",
      "path": "/capa/initiation"
    },
    {
      "module": "Capa",
      "name": "CAPA Initiation Approval",
      "slug": "CAPA_Initiation_Approval",
      "path": "/capa/initiation-approval"
    },
    {
      "module": "Capa",
      "name": "CAPA Implementation",
      "slug": "CAPA_Implementation",
      "path": "/capa/implementation"
    },
    {
      "module": "Capa",
      "name": "CAPA Implementation Closure",
      "slug": "CAPA_Implementation_Closure",
      "path": "/capa/implementation-closure"
    },
    {
      "module": "Capa",
      "name": "CAPA Effectiveness Implementation",
      "slug": "CAPA_Effectiveness_Implementation",
      "path": "/capa/effectiveness"
    },
    {
      "module": "Capa",
      "name": "CAPA Effectiveness Closure",
      "slug": "CAPA_Effectiveness_Closure",
      "path": "/capa/effectiveness-closure"
    },
    {
      "module": "Capa",
      "name": "CAPA Extension Initiation",
