{
  "name": "dms",
  "displayName": "DMS — Document Control",
  "baseUrl": "${DMS_BASE_URL}",
  "credentials": {
    "username": "${DMS_USER}",
    "password": "${DMS_PASSWORD}"
  },
  "auth": {
    "strategy": "api",
    "api": {
      "endpoint": "/api/authentication/login",
      "method": "POST",
      "body": {
        "username": "{{username}}",
        "password": "{{password}}",
        "ipAddress": "127.0.0.1",
        "latitude": "0",
        "longitude": "0"
      },
      "sessionStorage": {
        "authToken": "token",
        "userId": "userMaster.userID",
        "plantId": "userMaster.plantID",
        "userData": "userMaster::json"
      }
    },
    "verify": {
      "path": "/dashboard"
    }
  },
  "browser": {
    "headless": true,
    "viewport": {
      "width": 1440,
      "height": 900
    }
  },
  "autoFilter": {
    "enabled": true,
    "rangeDays": 365,
    "preferredUser": "Divy Bhadania"
  },
  "interactions": {
    "recipes": [
      "accordions",
      "toggleSweep",
      "dropdownSweep",
      "tabs",
      "filters",
      "openAdd",
      "rowView",
      "rowEdit",
      "rowDeactivate"
    ]
  },
  "routes": [
    {
      "module": "Dashboard",
      "name": "Dashboard",
      "slug": "Dashboard",
      "path": "/dashboard"
    },
    {
      "module": "Template Registration",
      "name": "Template Registration",
      "slug": "Template_Registration",
      "path": "/template-registration",
      "recipes": [
        "filters",
        "tabs",
        "accordions",
        "openAdd",
        "rowView",
        "rowEdit",
        "rowDeactivate"
      ]
    },
    {
      "module": "Template Approval",
      "name": "Template Approval",
      "slug": "Template_Approval",
      "path": "/template-approval",
