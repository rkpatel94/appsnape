    },
    {
      "module": "Extension",
      "name": "Deviation Extension",
      "slug": "Deviation_Extension",
      "path": "/extension/deviation-extension"
    },
    {
      "module": "Extension",
      "name": "Deviation Extension Approval",
      "slug": "Deviation_Extension_Approval",
